# CIBA Launchpad + CIBA OS — environment
# Everything runs in demo mode with NONE of these set. Add keys to go live.
# Copy to .env.local and fill in.

# ---- AI layer (assistant, triage, matching, readiness, Studio copy) ----
# Absent = demo mode (deterministic heuristics). Present = real Claude.
ANTHROPIC_API_KEY=

# ---- OS connectors ----
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=            # Gmail (and reusable for YouTube)
GOOGLE_CLIENT_SECRET=
QBO_CLIENT_ID=              # QuickBooks Online (Finance)
QBO_CLIENT_SECRET=
QBO_ENV=sandbox
BUFFER_ACCESS_TOKEN=        # legacy social scheduler (superseded by the Studio)

# =====================================================================
# Social Studio (/os/social) — create + publish video to YouTube/Instagram
# =====================================================================

# Three independent mock switches. Each follows MOCK_AI when unset except
# render/publish, which default to demo (safe) unless explicitly "false".
#   MOCK_AI     copy + narration text (template unless a Claude key is set)
#   MOCK_RENDER media rendering (sample clip; false = real ffmpeg/TTS/Pexels)
#   MOCK_PUBLISH publishing (fake ids; false = posts to REAL accounts)
MOCK_AI=true
MOCK_RENDER=true
MOCK_PUBLISH=true

# --- Rendering (only when MOCK_RENDER=false) ---
PEXELS_API_KEY=            # free at pexels.com/api — required to render
PIXABAY_API_KEY=          # optional second free footage source

# --- YouTube publishing (shared OAuth client; per-channel refresh tokens) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=            # base (empty channel prefix)
YT_SPEEDMANIA_REFRESH_TOKEN=
YT_GOALMANIA_REFRESH_TOKEN=

# --- Instagram publishing (per-channel long-lived tokens) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_SPEEDMANIA_USER_ID=
IG_SPEEDMANIA_ACCESS_TOKEN=
IG_GOALMANIA_USER_ID=
IG_GOALMANIA_ACCESS_TOKEN=

# --- Instagram public media host (Meta pulls the reel from a public URL) ---
# Either a GitHub repo (uses the gh CLI, free) or a bucket base URL.
CONTENT_CDN_REPO=          # e.g. deepanshh786/content-cdn
CONTENT_CDN_TAG=cdn
VIDEO_PUBLIC_BASE_URL=
